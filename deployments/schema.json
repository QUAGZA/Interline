{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interline.local/deployments/v2.schema.json",
  "title": "Interline V2 deployment manifest",
  "type": "object",
  "required": ["chainId", "factory", "startBlock", "markets", "oracleMode", "faucet"],
  "additionalProperties": false,
  "properties": {
    "chainId": { "type": "integer", "enum": [31337, 84532, 11155111] },
    "directFactory": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "directLens": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "factory": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "vaultFactory": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "recoveryEscrow": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "lens": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "startBlock": { "type": "integer", "minimum": 0 },
    "oracleMode": { "type": "string", "const": "simulated" },
    "faucet": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "loanToken": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "collateralToken": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "swapRouter": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "venue": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "curator": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "guardian": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "markets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "address", "label", "deliveryMode", "loanSymbol", "collateralSymbol"],
        "properties": {
          "id": { "type": "string" },
          "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "label": { "type": "string" },
          "deliveryMode": { "type": "string", "enum": ["wallet", "restricted"] },
          "loanSymbol": { "type": "string" },
          "collateralSymbol": { "type": "string" },
          "oracle": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
        }
      }
    }
  }
}
